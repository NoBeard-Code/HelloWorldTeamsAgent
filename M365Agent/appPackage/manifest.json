{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "NoBeard",
    "websiteUrl": "https://www.nobeard.hr",
    "privacyUrl": "https://www.nobeard.hr/privacy",
    "termsOfUseUrl": "https://www.nobeard.hr/termsofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Meeting prep agent",
    "full": "Full name for M365Agent"
  },
  "description": {
    "short": "Short description of M365Agent",
    "full": "Full description of M365Agent"
  },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": [
        "personal",
        "team",
        "groupChat",
        "copilot"
      ],
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "supportsFiles": true
    }
  ],
  "copilotAgents": {
    "customEngineAgents": [
      {
        "type": "bot",
        "id": "${{BOT_ID}}"
      }
    ]
  },
  "supportsChannelFeatures": "tier1",
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "devicePermissions": [
    "openExternal"
  ],
  "validDomains": [
    "${{BOT_DOMAIN}}"
  ]
}